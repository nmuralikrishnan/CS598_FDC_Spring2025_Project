  "descriptions": [
    {
      "description": "A curated and privacy-protected sample of service requests from Chicago's 311 system. The dataset has been processed through data cleaning and K-anonymity (k=5) de-identification to enable public research while protecting individual privacy. Suitable for urban planning, civic engagement analysis, and policy research.",
      "descriptionType": "Abstract"
    },
    {
      "description": "The dataset contains 28 variables including service request identifiers, temporal information (dates, resolution times), geographic data (generalized coordinates, ward, community area), service classifications (186 request types), and departmental information. Privacy protection implemented through K-anonymity (k=5) with ZIP codes generalized to 3 digits and coordinates rounded to 3 decimal places. Street addresses and other direct identifiers removed. Data retention: 96.9% of original sample.",
      "descriptionType": "Methods"
    }
  ],
